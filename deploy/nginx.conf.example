# AI Murder Mystery — Nginx 反向代理配置示例
# 部署到阿里云/腾讯云 ECS 后使用：
#   1) sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/ai-murder-mystery
#   2) 把 your-domain.com 替换为真实域名
#   3) sudo certbot --nginx -d your-domain.com   # 申请 Let's Encrypt 证书
#   4) sudo ln -s /etc/nginx/sites-available/ai-murder-mystery /etc/nginx/sites-enabled/
#   5) sudo nginx -t && sudo systemctl reload nginx
#
# 架构：
#   公网 (443/80) ─── Nginx (TLS 终止 + 限流) ─── 127.0.0.1:8747 (Node 容器)
# Node 容器端口通过 docker-compose ports: "127.0.0.1:8747:8747" 仅绑定本机回环。

# 限流 zone 定义（放在 http{} 顶层，这里如果在 sites-available 里需移到 nginx.conf）
# http {
#     limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
# }

server {
    listen 80;
    server_name your-domain.com;
    # HTTP 全部 301 跳转到 HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name your-domain.com;

    # Let's Encrypt 证书（certbot 自动生成路径）
    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # 安全 headers（与 Node 端的 securityHeaders 重复，但反代层再加一道更稳）
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 客户端上传体积限制（AI 请求体不会大，给 1MB 足够）
    client_max_body_size 1m;

    # 静态资源与 SPA 路由：全部由 Node 服务
    location / {
        proxy_pass http://127.0.0.1:8747;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API 代理端点：额外限流（10 req/s 突发 20）
    # 注意：limit_req_zone 需在 nginx.conf 的 http{} 顶层定义，见文件顶部注释
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8747;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # AI 调用可能慢，给足超时
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # 健康检查端点（可选，给外部监控用）
    location = /api/ready {
        proxy_pass http://127.0.0.1:8747;
        access_log off;
    }
}
